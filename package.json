{
  "name": "cliniqone",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:patient": "cd apps/patient && npx expo start",
    "dev:doctor": "cd apps/doctor && npx expo start",
    "dev:admin": "cd apps/admin && npm run dev",
    "dev:landing": "cd apps/landing && npm run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "test:e2e": "npx playwright test",
    "test:e2e:patient": "npx playwright test --project=patient-app",
    "test:e2e:doctor": "npx playwright test --project=doctor-web",
    "test:e2e:admin": "npx playwright test --project=admin-panel",
    "test:e2e:report": "npx playwright show-report",
    "postinstall": "node -e \"if(process.platform==='linux'){require('child_process').execSync('npm install --no-save lightningcss-linux-x64-gnu',{stdio:'inherit'})}\""
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "@playwright/test": "^1.58.2",
    "expo-asset": "^11.0.5",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "expo-haptics": "~14.0.1"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
