{
    "expo": {
        "name": "cliniq.one Doctor",
        "slug": "cliniqone-doctor",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "scheme": "cliniq-doctor",
        "userInterfaceStyle": "dark",
        "newArchEnabled": true,
        "splash": {
            "image": "./assets/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#0A0E1A"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.cliniqone.doctor"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#0A0E1A"
            },
            "package": "com.cliniqone.doctor"
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/favicon.png"
        },
        "plugins": [
            "expo-router",
            "expo-font"
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}