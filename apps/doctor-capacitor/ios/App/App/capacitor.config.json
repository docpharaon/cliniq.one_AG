{
	"appId": "com.cliniqone.doctor",
	"appName": "cliniq.one Doctor",
	"webDir": "www",
	"server": {
		"url": "https://cliniq-one-ag-doctor.vercel.app",
		"androidScheme": "https",
		"iosScheme": "https",
		"cleartext": false
	},
	"android": {
		"allowMixedContent": true,
		"backgroundColor": "#0A0E1A"
	},
	"ios": {
		"scheme": "App",
		"backgroundColor": "#0A0E1A",
		"contentInset": "automatic",
		"preferredContentMode": "mobile"
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 0,
			"backgroundColor": "#0A0E1A"
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0A0E1A"
		},
		"Keyboard": {
			"resize": "body",
			"resizeOnFullScreen": true
		},
		"LocalNotifications": {
			"smallIcon": "ic_notification",
			"iconColor": "#2DD4BF",
			"sound": "default"
		}
	},
	"packageClassList": [
		"AppPlugin",
		"CAPBrowserPlugin",
		"ClipboardPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"LocalNotificationsPlugin",
		"CAPNetworkPlugin",
		"PreferencesPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin",
		"ToastPlugin"
	]
}
