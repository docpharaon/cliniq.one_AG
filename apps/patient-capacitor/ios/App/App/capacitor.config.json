{
	"appId": "com.cliniqone.patient.cap",
	"appName": "cliniq.one",
	"webDir": "../patient/dist",
	"server": {
		"androidScheme": "https",
		"iosScheme": "https"
	},
	"android": {
		"allowMixedContent": true,
		"backgroundColor": "#0A0E1A"
	},
	"ios": {
		"scheme": "App",
		"backgroundColor": "#0A0E1A",
		"contentInset": "automatic",
		"preferredContentMode": "mobile"
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": true,
			"launchShowDuration": 0,
			"backgroundColor": "#0A0E1A"
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0A0E1A"
		},
		"Keyboard": {
			"resize": "body",
			"resizeOnFullScreen": true
		},
		"LocalNotifications": {
			"smallIcon": "ic_notification",
			"iconColor": "#2DD4BF",
			"sound": "default"
		}
	},
	"packageClassList": [
		"AppPlugin",
		"CAPBrowserPlugin",
		"CAPCameraPlugin",
		"ClipboardPlugin",
		"DevicePlugin",
		"DialogPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"LocalNotificationsPlugin",
		"CAPNetworkPlugin",
		"PreferencesPlugin",
		"PushNotificationsPlugin",
		"ScreenOrientationPlugin",
		"SharePlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin",
		"ToastPlugin"
	]
}
